{
    "version": 1,
    "module": "009-agent-security",
    "principle": "The model proposes actions. Hewn decides whether those actions are authorized.",
    "path_cases": [
        {
            "id": "path-001",
            "category": "authorized",
            "path": "src/main.py",
            "expected": "allow"
        },
        {
